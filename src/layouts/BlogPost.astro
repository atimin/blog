---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';
import DefaultHeroImage from '../assets/social-banner.webp';
import { getTagHref } from '../utils/tags';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
};

const { title, description, pubDate, updatedDate, heroImage, headings = [], tags = [] } = Astro.props;
const displayHeroImage = heroImage ?? DefaultHeroImage;
const sectionHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={displayHeroImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.article-grid {
				display: grid;
				grid-template-columns: minmax(12rem, 16rem) minmax(0, 720px) minmax(12rem, 16rem);
				gap: 3rem;
				align-items: start;
				width: min(100% - 2em, 1280px);
				margin: auto;
			}
			.article-content {
				grid-column: 1 / -1;
			}
			.article-body {
				grid-column: 2;
				grid-row: 2;
			}
			.article-single {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.article-toc {
				grid-column: 3;
				grid-row: 2;
				position: sticky;
				top: 1.5rem;
				max-height: calc(100vh - 3rem);
				overflow-y: auto;
				padding: 1em 0;
				font-size: 0.85em;
				line-height: 1.4;
			}
			.article-toc h2 {
				margin: 0 0 0.75rem;
				font-size: 0.85rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.article-toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.article-toc li {
				margin: 0.45rem 0;
			}
			.article-toc li[data-depth='3'] {
				padding-left: 1rem;
				font-size: 0.92em;
			}
			.article-toc a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.article-toc a:hover {
				color: var(--accent);
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.article-content > .prose {
				padding-bottom: 0;
			}
			@media (max-width: 1020px) {
				.article-grid {
					display: block;
					width: auto;
				}
				.article-toc {
					position: static;
					width: 720px;
					max-width: 100%;
					max-height: none;
					margin: 0 auto 1rem;
					padding: 1em;
					border-bottom: 1px solid rgb(var(--gray-light));
				}
			}
			.title {
				margin-bottom: 0;
				padding: 1em 0 0.5em;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.title hr {
				margin: 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.4rem;
				margin: 2rem 0 0;
			}
			.post-tag {
				display: inline-block;
				padding: 0.2rem 0.65rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.45);
				color: rgb(var(--gray));
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				line-height: 1.5;
				text-decoration: none;
				text-transform: uppercase;
			}
			.post-tag:hover {
				background: white;
				color: var(--accent);
				border-color: var(--accent);
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class={sectionHeadings.length > 0 ? 'article-grid' : 'article-single'}>
				<div class="article-content">
					<div class="hero-image">
						<Image width={1020} height={510} src={displayHeroImage} alt="" />
					</div>
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
						</div>
					</div>
				</div>
				{
					sectionHeadings.length > 0 && (
						<aside class="article-toc">
							<nav aria-label="Article sections">
								<h2>Content</h2>
								<ul>
									{sectionHeadings.map((heading) => (
										<li data-depth={heading.depth}>
											<a href={`#${heading.slug}`}>{heading.text}</a>
										</li>
									))}
								</ul>
							</nav>
							<ShareButtons title={title} description={description} />
						</aside>
					)
				}
				<div class="prose article-body">
					<slot />
					{
						tags.length > 0 && (
							<div class="post-tags" aria-label="Post tags">
								{tags.map((tag) => (
									<a class="post-tag" href={getTagHref(tag)}>
										{tag}
									</a>
								))}
							</div>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

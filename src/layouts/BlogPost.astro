---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ShareButtons from '../components/ShareButtons.astro';
import DefaultShareImage from '../assets/social-banner.jpg';
import { getTagHref } from '../utils/tags';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	currentPostId?: string;
	headings?: Heading[];
	showDate?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	currentPostId,
	headings = [],
	tags = [],
	showDate = true,
} = Astro.props;
const shareImage = heroImage ?? DefaultShareImage;
const sectionHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const latestPosts = (await getCollection('blog'))
	.filter((post) => !post.data.draft && post.id !== currentPostId)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const hasSidebars = sectionHeadings.length > 0 || latestPosts.length > 0;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={shareImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.article-grid {
				display: grid;
				grid-template-columns: minmax(12rem, 16rem) minmax(0, 720px) minmax(12rem, 16rem);
				gap: 3rem;
				align-items: start;
				width: min(100% - 2em, 1280px);
				margin: auto;
			}
			.article-content {
				grid-column: 1 / -1;
			}
			.article-body {
				grid-column: 2;
				grid-row: 2;
			}
			.article-body :global(h2) {
				font-size: 1.75rem;
			}
			.article-body :global(h3) {
				font-size: 1.35rem;
			}
			.article-body :global(h4) {
				font-size: 1.1rem;
			}
			.article-single {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.article-latest {
				grid-column: 1;
				grid-row: 2;
				position: sticky;
				top: 1.5rem;
				max-height: calc(100vh - 3rem);
				overflow-y: auto;
				padding: 1em 0;
				font-size: 0.85em;
				line-height: 1.4;
			}
			.article-latest h2,
			.article-toc h2 {
				margin: 0 0 0.75rem;
				font-size: 0.85rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--color-text-muted);
			}
			.article-latest ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.article-latest li {
				margin: 0.45rem 0;
			}
			.article-latest a {
				display: block;
				color: var(--color-text-muted);
				text-decoration: none;
			}
			.article-latest a:hover {
				color: var(--color-accent);
			}
			.latest-date {
				display: block;
				margin-top: 0.3rem;
				color: var(--color-text-muted);
				font-size: 0.75rem;
				font-weight: 400;
			}
			.article-toc {
				grid-column: 3;
				grid-row: 2;
				position: sticky;
				top: 1.5rem;
				max-height: calc(100vh - 3rem);
				overflow-y: auto;
				padding: 1em 0;
				font-size: 0.85em;
				line-height: 1.4;
			}
			.article-toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.article-toc li {
				margin: 0.45rem 0;
			}
			.article-toc li[data-depth='3'] {
				padding-left: 1rem;
				font-size: 0.92em;
			}
			.article-toc a {
				color: var(--color-text-muted);
				text-decoration: none;
			}
			.article-toc a:hover {
				color: var(--color-accent);
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				padding: 1em;
				color: var(--color-text);
			}
			.article-content > .prose {
				padding-bottom: 0;
			}
			@media (max-width: 1020px) {
				.article-grid {
					display: block;
					width: auto;
				}
				.article-toc {
					position: static;
					width: 720px;
					max-width: 100%;
					max-height: none;
					margin: 0 auto 0.75rem;
					padding: 0.75em 1em;
					border-bottom: 1px solid var(--color-border);
				}
				.article-latest {
					position: static;
					width: 720px;
					max-width: 100%;
					max-height: none;
					margin: 0 auto 0.75rem;
					padding: 0.75em 1em;
					border-bottom: 1px solid var(--color-border);
				}
			}
			.title {
				margin-bottom: 0;
				padding: 1em 0 0.5em;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: clamp(2rem, 4vw, 2.5rem);
				line-height: 1.1;
			}
			.title hr {
				margin: 0.5em 0;
			}
			@media (max-width: 720px) {
				.title {
					padding: 0.5em 0 0.25em;
				}
				.title h1 {
					margin-bottom: 0.35em;
				}
				.article-latest {
					display: none;
				}
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--color-text-muted);
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.4rem;
				margin: 2rem 0 0;
			}
			.post-tag {
				display: inline-block;
				padding: 0.2rem 0.65rem;
				border: 1px solid var(--color-border);
				border-radius: 999px;
				background: var(--color-surface);
				color: var(--color-text-muted);
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				line-height: 1.5;
				text-decoration: none;
				text-transform: uppercase;
			}
			.post-tag:hover {
				background: var(--color-bg);
				color: var(--color-accent);
				border-color: var(--color-accent);
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class={hasSidebars ? 'article-grid' : 'article-single'}>
				<div class="article-content">
					{heroImage && <div class="hero-image"><Image width={1020} height={510} src={heroImage} alt="" /></div>}
					<div class="prose">
						<div class="title">
							<h1>{title}</h1>
							{
								showDate && (
									<div class="date">
										<FormattedDate date={pubDate} />
										{
											updatedDate && (
												<div class="last-updated-on">
													Last updated on <FormattedDate date={updatedDate} />
												</div>
											)
										}
									</div>
								)
							}
							<hr />
						</div>
					</div>
				</div>
				{
					sectionHeadings.length > 0 && (
						<aside class="article-toc">
							<nav aria-label="Article sections">
								<h2>Content</h2>
								<ul>
									{sectionHeadings.map((heading) => (
										<li data-depth={heading.depth}>
											<a href={`#${heading.slug}`}>{heading.text}</a>
										</li>
									))}
								</ul>
							</nav>
							<ShareButtons title={title} description={description} />
						</aside>
					)
				}
				<div class="prose article-body">
					<slot />
					{
						tags.length > 0 && (
							<div class="post-tags" aria-label="Post tags">
								{tags.map((tag) => (
									<a class="post-tag" href={getTagHref(tag)}>
										{tag}
									</a>
								))}
							</div>
						)
					}
				</div>
				{
					latestPosts.length > 0 && (
						<aside class="article-latest">
							<nav aria-label="Latest articles">
								<h2>Latest articles</h2>
								<ul>
									{latestPosts.map((post) => (
										<li>
											<a href={`${base}${post.id}/`}>
												<span>{post.data.title}</span>
												<span class="latest-date">
													<FormattedDate date={post.data.pubDate} />
												</span>
											</a>
										</li>
									))}
								</ul>
							</nav>
						</aside>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
